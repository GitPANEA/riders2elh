[Unit]
Description=Riders2eLH API (dev)
After=network.target

[Service]
User=f.cavaliere
WorkingDirectory=/opt/riders2eLH
ExecStart=/usr/lib/jvm/jre-21-openjdk-21.0.11.0.10-1.0.1.el8.x86_64/bin/java -jar /opt/riders2eLH/riders2eLH.jar --spring.profiles.active=local
EnvironmentFile=/opt/riders2eLH/riders2eLH.env
Restart=on-failure

[Install]
WantedBy=multi-user.target
