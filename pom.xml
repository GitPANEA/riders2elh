<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>it.panea.deliveroo</groupId>
  <artifactId>riderpay</artifactId>
  <version>0.1.0</version>
  <name>riderpay</name>
  <description>API di ingestione + modello dati Oracle per i pagamenti rider Deliveroo</description>

  <properties>
    <java.version>21</java.version>

    <!--.B.- REMOTE DEPLOY Pipeline -->
    <remote.deploy.port>22</remote.deploy.port>
    <remote.deploy.username>f.cavaliere</remote.deploy.username>
    <!-- riderpay_deploy_key: coppia RSA 4096 generata appositamente per il deploy dev
         (svc-claude.key risultava corrotta/non valida anche dopo la sostituzione dalla stessa
         fonte). Generata gia' in formato PEM classico ("RSA PRIVATE KEY"), compatibile con
         JSch 0.1.55. La chiave pubblica va autorizzata su 10.10.7.46 in
         ~f.cavaliere/.ssh/authorized_keys. -->
    <remote.deploy.keyfile>C:\Sirfin Documents\ProdKey\riderpay_deploy_key</remote.deploy.keyfile>
    <maven.deploy.skip>true</maven.deploy.skip>

    <!-- default DEV values -->
    <remote.deploy.host>10.10.7.46</remote.deploy.host>
    <remote.deploy.target.dir>/opt/riderpay</remote.deploy.target.dir>
    <!--.E.- REMOTE DEPLOY Pipeline -->
  </properties>

  <profiles>
    <profile>
      <id>dev</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <remote.deploy.host>10.10.7.46</remote.deploy.host>
        <remote.deploy.target.dir>/opt/riderpay</remote.deploy.target.dir>
        <spring.profiles.active>local</spring.profiles.active>
      </properties>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>1.11.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-resource-server</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>riderpay</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--.B.- Ant-run: SCP deploy to remote server -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>deploy-jar</id>
            <phase>deploy</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <echo message="==== AVVIO deploy JAR su host remoto ${remote.deploy.host} AT ${remote.deploy.target.dir}====" />
                <scp
                  todir="${remote.deploy.username}@${remote.deploy.host}:${remote.deploy.target.dir}"
                  port="${remote.deploy.port}"
                  keyfile="${remote.deploy.keyfile}"
                  trust="true"
                  sftp="true"
                  verbose="true"
                  failonerror="true">
                  <fileset dir="${project.build.directory}">
                    <include name="${project.build.finalName}.jar"/>
                  </fileset>
                </scp>
                <echo message="==== Deploy JAR completato ===="/>
              </target>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant-jsch</artifactId>
            <version>1.10.14</version>
          </dependency>
          <dependency>
            <groupId>com.jcraft</groupId>
            <artifactId>jsch</artifactId>
            <version>0.1.55</version>
          </dependency>
        </dependencies>
      </plugin>
      <!--.E.- Ant-run: SCP deploy to remote server -->
    </plugins>
  </build>

</project>
